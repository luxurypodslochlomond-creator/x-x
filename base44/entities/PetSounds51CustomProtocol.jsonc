{
  "name": "PetSounds51CustomProtocol",
  "type": "object",
  "description": "A protocol AI51 built for one animal with one problem. It carries the owner's address and what is wrong with their pet, so only a keeper may read it back, change it or remove it. The page that creates a custom protocol still works: it adds the line and nothing else \u2014 nobody, and no other visitor, can read another owner's pet or reach their email from here.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner email"
    },
    "pet_name": {
      "type": "string",
      "description": "Pet's name"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "horse",
        "farm"
      ],
      "description": "Animal type"
    },
    "issue": {
      "type": "string",
      "description": "What they're treating"
    },
    "protocol_data": {
      "type": "object",
      "description": "AI51's custom protocol (frequencies, timing, etc)"
    },
    "created_by_ai51": {
      "type": "boolean",
      "default": true,
      "description": "AI-generated protocol"
    },
    "effectiveness_rating": {
      "type": "number",
      "description": "How well it worked (1-10)"
    },
    "owner_notes": {
      "type": "string",
      "description": "Progress updates from owner"
    }
  },
  "required": [
    "user_email",
    "pet_name",
    "species",
    "issue",
    "protocol_data"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}