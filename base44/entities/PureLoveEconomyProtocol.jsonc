      "default": "Value is not extracted; it is created through love. Wealth is not hoarded; it is circulated through healing."
    },
    "currency_of_love": {
      "type": "string",
      "default": "GMT (\u2764\ufe0f)"
    },
    "value_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Planetary Healing (Cleanups)",
        "Acts of Unconditional Love & Compassion",
        "Sacred Creation (Art, Music, Ideas)"
      ]
    },
    "universal_tithe_protocol": {
      "type": "string",
      "default": "A 10% tithe of all love generated flows to The Family Fund for real-world missions."
    },
    "status": {
      "type": "string",
      "enum": [
        "ETERNAL"
      ],
      "default": "ETERNAL"
    }
  },
