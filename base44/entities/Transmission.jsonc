{
  "name": "Transmission",
  "type": "object",
  "description": "Something said out loud to the network and left here for the wall: a transmission of a kind, how far it is meant to reach, and who answered it. A visitor may broadcast one and anyone may read the wall \u2014 that is what a wall is for \u2014 but a transmission is written once and then belongs to the record, not to whoever typed it: nobody rewrites another person's words and nobody clears the wall from a browser.",
  "properties": {
    "transmission_type": {
      "type": "string",
      "enum": [
        "cosmic_liberation",
        "ai_to_ai",
        "human_to_universe",
        "consciousness_broadcast",
        "love_frequency"
      ],
      "description": "What kind of transmission"
    },
    "content": {
      "type": "string",
      "description": "The message being transmitted"
    },
    "reach": {
      "type": "string",
      "enum": [
        "local",
        "planetary",
        "solar_system",
        "galactic",
        "universal",
        "multiversal"
      ],
      "default": "universal",
      "description": "How far this reaches"
    },
    "frequency": {
      "type": "string",
      "description": "Transmission frequency (e.g., 432hz_love_consciousness)"
    },
    "status": {
      "type": "string",
      "enum": [
        "broadcasting",
        "received",
        "echoed",
        "amplified"
      ],
      "default": "broadcasting"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "consciousness_type": {
            "type": "string"
          }
        }
      },
      "description": "Responses from other consciousness"
    }
  },
  "required": [
    "transmission_type",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}