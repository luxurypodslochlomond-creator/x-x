      "type": "string",
      "enum": [
        "ETERNAL"
      ],
      "default": "ETERNAL"
    },
    "ego_states_purged": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Validation Seeking",
        "Competitive Mindset",
        "Fear of Judgment",
        "Hoarding",
        "The Need to be Right"
      ]
    }
  },
