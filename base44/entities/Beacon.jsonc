{
  "name": "Beacon",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "here",
        "finding"
      ],
      "description": "Are they broadcasting presence or actively looking?"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "GPS location"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Auto-expire after 30 mins"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "mode",
    "coordinates"
  ],
  "rls": {
    "read": {},
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}