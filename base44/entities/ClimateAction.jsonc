{
  "name": "ClimateAction",
  "type": "object",
  "description": "Public climate actions on the 'Together We Change Climate' platform \u2014 cleanups, plantings, meetings, policy submissions. Reviewed before publication like solutions. No messaging stored on platform; organizers provide one contact link. Public submissions welcome with email. An action that points at more information carries the link to its origin, and how well it is known is kept in the open. The organiser's own email is kept back: it is how the record reaches them, never something a reader receives.",
  "properties": {
    "title": {
      "type": "string",
      "description": "What's happening \u2014 e.g. 'Mangrove planting day, Cardigan Bay'"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "cleanup",
        "planting",
        "meeting",
        "policy_submission",
        "workshop",
        "monitoring",
        "other"
      ],
      "description": "Type of action"
    },
    "group_id": {
      "type": "string",
      "description": "Optional link to a ClimateGroup organizing this action"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "When the action is happening"
    },
    "region_rough": {
      "type": "string",
      "description": "Rough location \u2014 privacy-respecting, no precise coordinates"
    },
    "country": {
      "type": "string",
      "description": "Country / region"
    },
    "description": {
      "type": "string",
      "description": "What, why, and how to join \u2014 plain language"
    },
    "contact_link": {
      "type": "string",
      "description": "One contact link \u2014 email, WhatsApp, Signal, or signup URL. The platform never sees the messages."
    },
    "source_url": {
      "type": "string",
      "description": "Optional link to more info or evidence"
    },
    "verification": {
      "type": "string",
      "enum": [
        "single_source",
        "corroborated",
        "official_record"
      ],
      "default": "single_source",
      "description": "How well this action is known, said out loud on the action itself: single_source \u2014 one origin says so; corroborated \u2014 two independent origins agree; official_record \u2014 the body behind it has put it on the record. Left at single_source until a second, independent origin is actually named, because that is the honest answer. Set by a person (admin), never by the action's own text."
    },
    "corroborating_source": {
      "type": "string",
      "description": "A second, independent origin saying the same thing, when one exists \u2014 named here, never guessed."
    },
    "correction_note": {
      "type": "string",
      "description": "A correction, in the open, with the date it was made. Actions on the record are corrected in daylight, never silently."
    },
    "editor": {
      "type": "string",
      "description": "The named person who signed this action onto the record. Shown on the action beside its source, so a reader can hold a person to it. Written when a person publishes it, never by the action's own text. Left empty it means the action is unsigned, and the action says so plainly rather than showing nothing \u2014 a machine can never fill this, because it has no name to sign with."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ],
      "default": "published",
      "description": "All material reviewed before publication, same as solutions. Public submissions default to draft."
    },
    "category": {
      "type": "string",
      "description": "Category \u2014 dynamic, managed by admins through the ClimateCategory entity. Falls back to the built-in taxonomy."
    },
    "submitter_name": {
      "type": "string",
      "description": "Name of the person who submitted this action"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email of the submitter \u2014 required per Janine's spec for public submissions. Used only to reach them about this action: never published, and never handed to a reader. Only a keeper may read it back.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "description": "Flagged by spam filter for admin attention"
    },
    "ai_assessment": {
      "type": "string",
      "description": "AI pre-screener assessment \u2014 verdict, relevance, reasons"
    }
  },
  "required": [
    "title",
    "action_type",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}