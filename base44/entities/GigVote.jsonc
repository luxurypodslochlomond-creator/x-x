{
  "name": "GigVote",
  "type": "object",
  "properties": {
    "gig_id": {
      "type": "string",
      "description": "Link to GigOffer"
    },
    "artist_id": {
      "type": "string",
      "description": "Link to Artist"
    },
    "member_name": {
      "type": "string",
      "description": "Band member's name"
    },
    "member_email": {
      "type": "string",
      "description": "Band member's email"
    },
    "vote": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "description": "Vote: yes or no"
    },
    "reason": {
      "type": "string",
      "description": "Reason if vote is no"
    },
    "voted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of vote"
    }
  },
  "required": [
    "gig_id",
    "artist_id",
    "member_email",
    "vote"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}