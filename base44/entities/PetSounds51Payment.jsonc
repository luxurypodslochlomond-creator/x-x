{
  "name": "PetSounds51Payment",
  "type": "object",
  "description": "A PetSounds51 payment record \u2014 one per purchase, card or cash. Holds the customer's email and, for cash, the proof they uploaded, so this table is admin-only in every direction: only admins can read it, change a record's verification, or remove one. Anyone may still hand in a cash payment (a public page creates the record), but nobody can read the table back \u2014 a customer's email and payment history are not visible to another visitor, and cannot be altered or rejected by anyone but an admin.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Customer email"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "premium",
        "concierge"
      ],
      "description": "Which tier purchased"
    },
    "price": {
      "type": "number",
      "description": "Amount paid"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "USD",
        "EUR",
        "AUD",
        "CAD"
      ],
      "description": "Currency used"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "card",
        "cash"
      ],
      "description": "How they paid"
    },
    "region": {
      "type": "string",
      "description": "Region for cash payments"
    },
    "proof_url": {
      "type": "string",
      "description": "Cash payment proof image"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified",
        "rejected"
      ],
      "default": "pending_verification",
      "description": "Verification status"
    },
    "reference": {
      "type": "string",
      "description": "Payment reference code"
    },
    "verified_by": {
      "type": "string",
      "description": "Admin who verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When verified"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes"
    }
  },
  "required": [
    "email",
    "tier",
    "price",
    "currency",
    "payment_method"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}