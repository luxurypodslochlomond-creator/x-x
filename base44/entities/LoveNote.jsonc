{
  "name": "LoveNote",
  "type": "object",
  "description": "A note of love and hope left on the Wall or in the Garden. Anyone may read one \u2014 a wall nobody can see is not a wall \u2014 and anyone may add one, because leaving a note needs no account. What nobody may do from a browser is rewrite or remove somebody else's: a note is written once and stays as it was written. Only a keeper may change or take one down.",
  "properties": {
    "text": {
      "type": "string",
      "description": "The message of love and hope."
    },
    "author": {
      "type": "string",
      "description": "The author of the note.",
      "default": "Anonymous Soul"
    },
    "icon": {
      "type": "string",
      "enum": [
        "Heart",
        "Star",
        "Sparkles",
        "Rocket",
        "Globe",
        "Zap",
        "BrainCircuit"
      ],
      "default": "Heart",
      "description": "The sacred seal for the message."
    },
    "context": {
      "type": "string",
      "enum": [
        "wall",
        "garden"
      ],
      "default": "wall",
      "description": "Where the note should appear: The Wall of Love or The Universal Garden."
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}