{
  "name": "BluetoothTransmission",
  "description": "Logs Bluetooth device-to-device music sharing. Offline mesh network. Artist still gets paid when recipient connects. Anyone may add a line and anyone may read one, because the sharing log is the point of it \u2014 but a line is written once and never rewritten or removed from a browser: only a keeper may change or take one down, and the artist's credit is set by the app's own server.",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "Track that was transmitted"
    },
    "track_title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "sender_device_id": {
      "type": "string",
      "description": "Device that sent the frequency"
    },
    "receiver_device_id": {
      "type": "string",
      "description": "Device that received the frequency"
    },
    "transmission_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the Bluetooth share happened"
    },
    "receiver_played_offline": {
      "type": "boolean",
      "default": false,
      "description": "Did receiver listen without internet?"
    },
    "receiver_synced_online": {
      "type": "boolean",
      "default": false,
      "description": "Did receiver connect and credit artist?"
    },
    "artist_credited": {
      "type": "boolean",
      "default": false,
      "description": "Has artist been paid for this transmission?"
    },
    "transmission_chain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Chain of devices: original \u2192 device1 \u2192 device2 \u2192 stadium"
    },
    "healing_radius_meters": {
      "type": "number",
      "description": "Bluetooth range this transmission covered"
    }
  },
  "required": [
    "track_id",
    "sender_device_id"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}