      "description": "The sacred text that provides the rhythm for this protocol.",
      "default": "Marshall Jefferson - Move Your Body (The House Music Anthem)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ETERNAL"
      ],
      "default": "ETERNAL"
    }
  },
  "required": [],
