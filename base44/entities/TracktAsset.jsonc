{
  "name": "TracktAsset",
  "type": "object",
  "description": "A tagged thing being tracked \u2014 a wheelchair, a pallet, a pump. The live board reads it, and the board also sets a status by hand, so reads and updates stay open as they were. What changes here is the two doors nothing was standing behind: nothing may add an asset from a browser, and nothing may delete one. Assets arrive through the reader's own ingest, which writes with the service role.",
  "properties": {
    "tag_id": {
      "type": "string",
      "description": "RFID/EPC tag identifier"
    },
    "asset_name": {
      "type": "string",
      "description": "Human-readable asset name (e.g. Wheelchair-07, Infusion Pump 3B)"
    },
    "asset_type": {
      "type": "string",
      "description": "Category of asset (e.g. medical_equipment, pallet, tool, vehicle)"
    },
    "location": {
      "type": "string",
      "description": "Last known location (reader name or zone)"
    },
    "reader_id": {
      "type": "string",
      "description": "ID of the RFID reader that last scanned this tag"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of most recent scan"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "missing",
        "overdue",
        "flagged"
      ],
      "default": "active",
      "description": "Current asset status"
    },
    "site": {
      "type": "string",
      "description": "Site name (e.g. Ward 4, Warehouse A, Zone 3)"
    },
    "scan_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of scans recorded"
    },
    "metadata": {
      "type": "object",
      "description": "Additional asset metadata (serial number, manufacturer, etc.)"
    }
  },
  "required": [
    "tag_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}