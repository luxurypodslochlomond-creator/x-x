{
  "name": "ScottMerchSale",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Link to ScottEvent"
    },
    "merch_id": {
      "type": "string",
      "description": "Link to ScottMerch"
    },
    "quantity": {
      "type": "number",
      "description": "How many sold"
    },
    "total_revenue": {
      "type": "number",
      "description": "Total cash taken in \u00a3"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Any issues, hot sellers, etc"
    }
  },
  "required": [
    "event_id",
    "merch_id",
    "quantity",
    "total_revenue"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}