{
  "name": "FreedomCode",
  "type": "object",
  "description": "A one-time code worth Love Currency. It is a bearer token in everything but name: whoever reads the string can claim the amount, so the table is closed to everyone except an administrator. It used to be readable by anyone with the link, which meant every unclaimed code on the record was published along with it. Codes are issued and claimed through a server function with the service role, which is not subject to these rules.",
  "properties": {
    "code": {
      "type": "string",
      "description": "The unique, one-time use code for claiming Love Currency."
    },
    "amount": {
      "type": "number",
      "description": "The amount of Love Currency this code is worth."
    },
    "is_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this code has been claimed."
    },
    "claimed_by": {
      "type": "string",
      "description": "The ID of the user who claimed the code."
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code was claimed."
    }
  },
  "required": [
    "code",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}