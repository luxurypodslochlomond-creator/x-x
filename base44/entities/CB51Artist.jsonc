{
  "name": "CB51Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Artist name"
    },
    "owner_email": {
      "type": "string",
      "description": "Primary owner email \u2014 for team access control"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "profile_pic_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "bio": {
      "type": "string",
      "description": "Artist bio"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Music genres"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether artist is archived"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}