{
  "name": "TracktScanEvent",
  "type": "object",
  "description": "One line for every time an RFID tag was seen \u2014 a business's asset moving through a real building. Written by the reader and read by the dashboard through the app's own server, so it is admin-only in every direction: read, add, change and remove. A stranger could previously read a client's whole asset register from this table, and write to it.",
  "properties": {
    "tag_id": {
      "type": "string",
      "description": "RFID/EPC tag that was scanned"
    },
    "reader_id": {
      "type": "string",
      "description": "Reader/antenna that detected the tag"
    },
    "location": {
      "type": "string",
      "description": "Physical location of the reader"
    },
    "site": {
      "type": "string",
      "description": "Site identifier"
    },
    "rssi": {
      "type": "number",
      "description": "Signal strength (dBm) \u2014 used for proximity estimation"
    },
    "scan_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact time of scan"
    },
    "asset_name": {
      "type": "string",
      "description": "Resolved asset name at time of scan"
    },
    "raw_payload": {
      "type": "object",
      "description": "Raw JSON from the RFID reader for audit purposes"
    }
  },
  "required": [
    "tag_id",
    "scan_timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}