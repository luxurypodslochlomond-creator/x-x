{
  "name": "HeartbeatPulse",
  "type": "object",
  "description": "A heartbeat offered to the pulse map \u2014 beats per minute and a rough place, updated as someone sits with it. Anyone may offer one and anyone may see the pulse, because a map of one heartbeat is not a pulse \u2014 but a browser may not empty the map: only a keeper removes a pulse.",
  "properties": {
    "bpm": {
      "type": "number",
      "description": "Beats per minute from HRV reading"
    },
    "hrv_coherence": {
      "type": "number",
      "description": "Heart rate variability coherence score 0-100"
    },
    "location": {
      "type": "string",
      "description": "General location of contributor"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Geographic coordinates for map"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Is this heartbeat currently contributing to the pulse?"
    },
    "last_ping": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat contribution timestamp"
    }
  },
  "required": [
    "bpm"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}