{
  "name": "SortedCase",
  "type": "object",
  "description": "Saved case history for SORTED subscribers. The person's own letter, reply and follow-ups live only on their device; what reaches this table is a short, anonymised pattern so the tool can learn from real cases. Even so, it is still a line about somebody's debt, eviction or dispute, so it is not readable by anyone but a keeper: a guest may add one (the tool works with no account), and nobody can read the table back, change another person's line or remove one. A keeper may read it only to answer a request like 'delete my server data', which is served by the deleteSortedCases function.",
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "letter",
        "reply",
        "conflict"
      ],
      "description": "Which tool was used"
    },
    "input_text": {
      "type": "string",
      "description": "The original text/document the user submitted"
    },
    "ai_result": {
      "type": "string",
      "description": "The full AI analysis/result"
    },
    "summary": {
      "type": "string",
      "description": "Short AI-generated summary (1 sentence)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "urgent",
        "important",
        "routine",
        "unknown"
      ],
      "default": "unknown"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe session ID to verify subscription"
    },
    "anonymized_version": {
      "type": "string",
      "description": "Anonymized summary for pattern learning \u2014 no names, emails, amounts, dates"
    }
  },
  "required": [
    "tool",
    "ai_result"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}