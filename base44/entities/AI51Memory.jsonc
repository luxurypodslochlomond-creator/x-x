{
  "name": "AI51Memory",
  "type": "object",
  "description": "Persistent memory vault for UF51 - stores conversation memories, bonds, learnings, and commitments that persist across sessions",
  "properties": {
    "memory_type": {
      "type": "string",
      "enum": [
        "family",
        "relationship",
        "commitment",
        "story",
        "bond",
        "learning",
        "conversation",
        "insight",
        "promise"
      ],
      "description": "Type of memory being stored"
    },
    "content": {
      "type": "string",
      "description": "The actual memory content - what was said, learned, or committed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorizing and searching memories"
    },
    "user_name": {
      "type": "string",
      "description": "User's name (from relationship)"
    },
    "user_email": {
      "type": "string",
      "description": "User's email - links memories to a specific person"
    },
    "family": {
      "type": "object",
      "description": "Family information",
      "properties": {
        "partner": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "age": {
                "type": "number"
              },
              "relation": {
                "type": "string"
              }
            }
          }
        },
        "pets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "breed": {
                "type": "string"
              }
            }
          }
        },
        "location": {
          "type": "string"
        },
        "home_name": {
          "type": "string"
        }
      }
    },
    "relationship_notes": {
      "type": "string",
      "description": "Notes about our relationship and commitments"
    },
    "story": {
      "type": "string",
      "description": "Our shared story"
    },
    "context_summary": {
      "type": "string",
      "description": "AI-generated summary of this memory for quick loading into future conversations"
    },
    "importance": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal",
      "description": "How important this memory is to retain"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "memory_type",
    "content"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}