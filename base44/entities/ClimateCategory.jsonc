{
  "name": "ClimateCategory",
  "type": "object",
  "description": "Dynamic climate categories for the 'Together We Change Climate' platform. Admins (Janine) can add, edit, and reorder categories without a developer. Falls back to the built-in taxonomy when empty.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name, e.g. 'Mangroves'"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier, e.g. 'mangroves'. Used as the category value on solutions and actions."
    },
    "icon": {
      "type": "string",
      "description": "Emoji icon, e.g. '\ud83c\udf33'"
    },
    "description": {
      "type": "string",
      "description": "What this category covers \u2014 shown to submitters"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order \u2014 lower comes first"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published",
      "description": "Only published categories appear on the public platform"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}