{
  "name": "ClimateChecker",
  "type": "object",
  "description": "Who may come into the record, and what they may do once inside. One list, two kinds of line: a checker is a pair of eyes \u2014 they read what is waiting and write a note in their own name, and that is all; a keeper is the person the record answers to \u2014 the founder \u2014 and they alone may put an entry on the record or hold it back. The flag on the line decides which, so the record has one guest list rather than two that drift apart. Neither kind can see a submitter's email, and neither holds the app's admin keys: being the keeper of this record gives the record's own power and nothing else in the building. A keeper adds and removes these lines; nobody can add themselves.",
  "properties": {
    "email": {
      "type": "string",
      "description": "The exact address the checker signs in with. Required, and what the record matches against, so it is never guessed or partly filled."
    },
    "name": {
      "type": "string",
      "description": "The name their notes are signed with, so a line of checking carries a person rather than an address."
    },
    "is_keeper": {
      "type": "boolean",
      "default": false,
      "description": "This line is the keeper: they may publish an entry onto the record or hold it back, and their name is written into the audit trail when they do. Left false it is a checker \u2014 a pair of eyes, with no power to publish, change or delete anything. A keeper does not need to be an administrator of the app, and should not be: the record's keys are not the building's keys."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether they may come in today. Turned off it stops access immediately and keeps the record of what they wrote, because ending access is not the same as erasing work."
    },
    "note": {
      "type": "string",
      "description": "Why this person is on the list, e.g. 'Trebuchet volunteer, coastal restoration'. Kept so a keeper in a year knows who they were and why."
    },
    "added_by": {
      "type": "string",
      "description": "The keeper who put them on the list."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}