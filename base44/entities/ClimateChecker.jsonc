{
  "name": "ClimateChecker",
  "type": "object",
  "description": "The record's private guest list. Checkers read entries and sign notes; keepers manage publication and record access without becoming app administrators. Access changes are authorised by the server. Public roll text belongs to the person who wrote it. Email timestamps record acceptance for sending, never inbox delivery or opening.",
  "properties": {
    "email": {
      "type": "string",
      "description": "The exact address used to sign in, stored in lower case. Never public."
    },
    "name": {
      "type": "string",
      "description": "The name used to sign this person's work."
    },
    "is_keeper": {
      "type": "boolean",
      "default": false,
      "description": "Record keeper, not an app administrator. False means checker."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this person may work on the record now. Pausing preserves their work."
    },
    "note": {
      "type": "string",
      "description": "The keeper's private note about why this person was invited."
    },
    "public_line": {
      "type": "string",
      "description": "The person's own optional words for the public roll. Only that person may write or clear them through the server. Empty means not on the public roll."
    },
    "public_line_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the person last changed or cleared their own public line."
    },
    "added_by": {
      "type": "string",
      "description": "The keeper who added this person."
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy invitation timestamp. Older values were written before an email was attempted, so this alone is not evidence of sending."
    },
    "sign_in_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "The latest sign-in invitation accepted by the invitation service. Never proof of inbox delivery."
    },
    "sign_in_error": {
      "type": "string",
      "description": "The latest sign-in invitation failure. Empty after a successful send request. Separate from the welcome email outcome."
    },
    "notice_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "The latest record email accepted for sending. Preserved if a later attempt fails. Never proof of inbox delivery."
    },
    "notice_error": {
      "type": "string",
      "description": "Why the latest attempt to send the record email failed. Empty after an accepted send."
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this person's own signed-in account was first recognised on the guest list. Never inferred from an email being opened."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}