{
  "name": "BuzzStopReport",
  "type": "object",
  "description": "User-submitted problem reports for the BuzzStop tinnitus tool. A report is somebody describing a symptom in their own words, so it is admin-only in every direction: read, add, change and remove. Nothing writes to this table today.",
  "properties": {
    "user_issue": {
      "type": "string",
      "description": "The issue reported by the user"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "resolved"
      ],
      "default": "submitted",
      "description": "Current status of the report"
    },
    "ai_response": {
      "type": "string",
      "description": "AI51's troubleshooting suggestion or response"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the issue was reported"
    }
  },
  "required": [
    "user_issue"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}