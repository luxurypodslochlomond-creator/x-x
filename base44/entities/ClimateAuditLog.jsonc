{
  "name": "ClimateAuditLog",
  "type": "object",
  "description": "Audit trail for the climate record \u2014 who decided, what they decided, and the AI note that sat beside the decision but never made it. One line every time a keeper puts an entry on the record or holds it back, and one line every time somebody is given the keys, paused, restored or taken off the list, so the answer to 'who allowed this' \u2014 or 'who shut that person out, and when' \u2014 is a row rather than a shrug. Covers solutions, crises, actions, comments, gatherings, entries on the wire, the music given to the record, and access to the record itself. Admin-only access, because the reviewer's own address is in it and that address belongs to the person who took the decision, not to the public. This is the accountability record review panels ask for.",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "solution",
        "action",
        "comment",
        "news",
        "group",
        "track",
        "keeper"
      ],
      "description": "What was acted on: an entry on the record, or keeper \u2014 access to the record itself, written when somebody was added, paused, restored or removed."
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the reviewed entity, or of the roster line for an access change."
    },
    "entity_title": {
      "type": "string",
      "description": "Title or preview of the reviewed entity, or the name on the roster line for an access change."
    },
    "action": {
      "type": "string",
      "enum": [
        "published",
        "held",
        "rejected",
        "access_granted",
        "access_paused",
        "access_restored",
        "access_removed"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "green",
        "yellow",
        "green",
        "red"
      ],
      "description": "What the keeper decided. published \u2014 it is on the record. held \u2014 it waits, untouched: a hold is a not-yet and is never counted as a rejection, because calling it one would put a word in a person's mouth. access_granted, access_paused, access_restored, access_removed \u2014 someone was given the keys, paused, let back in, or taken off the list. Being counted out is written down the same as being counted in, so nobody can quietly open or close the door."
    },
    "reviewer_email": {
      "type": "string",
      "description": "The address of the keeper who took the decision. This is the accountability line: it names a person, so a reader can hold someone to the decision. Never shown to a visitor."
    },
    "ai_assessment": {
      "type": "string",
      "description": "The AI advisory note, or the keeper's own reason for holding an entry or changing somebody's access. Kept as it was at the moment of the decision rather than re-read later."
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "action",
    "reviewer_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}