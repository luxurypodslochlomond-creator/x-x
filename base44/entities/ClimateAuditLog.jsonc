{
  "name": "ClimateAuditLog",
  "type": "object",
  "description": "Audit trail for the climate record \u2014 who decided, what they decided, and the AI note that sat beside the decision but never made it. One line every time a keeper puts an entry on the record or holds it back, so the answer to 'who allowed this' is a row rather than a shrug. Covers solutions, crises, actions, comments, gatherings, entries on the wire, and the music given to the record. Admin-only access, because the reviewer's own address is in it and that address belongs to the person who took the decision, not to the public. This is the accountability record review panels ask for.",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "solution",
        "action",
        "comment",
        "news",
        "group",
        "track"
      ],
      "description": "Type of entity that was reviewed"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the reviewed entity"
    },
    "entity_title": {
      "type": "string",
      "description": "Title or preview of the reviewed entity"
    },
    "action": {
      "type": "string",
      "enum": [
        "published",
        "held",
        "rejected"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "description": "What the keeper decided. published \u2014 it is on the record. held \u2014 it waits, untouched: a hold is a not-yet and is never counted as a rejection, because calling it one would put a word in a person's mouth."
    },
    "reviewer_email": {
      "type": "string",
      "description": "The address of the keeper who took the decision. This is the accountability line: it names a person, so a reader can hold someone to the decision. Never shown to a visitor."
    },
    "ai_assessment": {
      "type": "string",
      "description": "The AI advisory note, or the keeper's own reason for holding an entry. Kept as it was at the moment of the decision rather than re-read later."
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "action",
    "reviewer_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}