{
  "name": "ClimateSolution",
  "type": "object",
  "description": "A verified climate solution or climate-crisis entry on the 'Together We Change Climate' public platform. Faithful to Janine Selendy's spec: two summary types (Solutions / Climate Crisis), her category taxonomy, rough location, image, and translation-ready fields. Public submissions welcome with email \u2014 reviewed before publication. Every entry must trace to its origin: the source fields below are the entry's reason for being on the record.",
  "properties": {
    "entry_type": {
      "type": "string",
      "enum": [
        "solution",
        "climate_crisis"
      ],
      "description": "Solution (a positive action to replicate) or Climate Crisis (an emergency to alert the world to)"
    },
    "title": {
      "type": "string",
      "description": "Title of this entry"
    },
    "summary": {
      "type": "string",
      "description": "Short summary shown on the card and when tapping the image"
    },
    "details": {
      "type": "string",
      "description": "Longer description / LinkedIn-style detail body"
    },
    "category": {
      "type": "string",
      "description": "Category \u2014 dynamic, managed by admins through the ClimateCategory entity. Falls back to the built-in taxonomy."
    },
    "subcategory": {
      "type": "string",
      "description": "Subcategory, e.g. agriculture: water supply, drought, resilient crops"
    },
    "country": {
      "type": "string",
      "description": "Country / region \u2014 rough mapping only, privacy-respecting"
    },
    "region_rough": {
      "type": "string",
      "description": "Rough location for mapping (no precise coordinates, per her privacy stance)"
    },
    "image_url": {
      "type": "string",
      "description": "Copyright-free image URL"
    },
    "image_credit": {
      "type": "string",
      "description": "Image source/credit"
    },
    "source_name": {
      "type": "string",
      "description": "Who says so \u2014 the body, journal, paper or person that published the original, e.g. 'Kleinman Center for Energy Policy'"
    },
    "source_url": {
      "type": "string",
      "description": "The link to the origin itself. An entry with no link to its origin waits for a person: they either find it or leave the entry out."
    },
    "source_author": {
      "type": "string",
      "description": "Who wrote the original, when it is stated \u2014 e.g. 'Jack Leitzell'. Part of the citation, kept exactly as the origin gives it."
    },
    "source_date": {
      "type": "string",
      "description": "When the original was published, as the origin states it \u2014 e.g. '21 April 2025'. Left empty when it is not stated: never guessed."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ],
      "default": "published",
      "description": "All material must be reviewed before publication (per Solutions Site model). Public submissions default to draft."
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show in the top image carousel"
    },
    "scale": {
      "type": "string",
      "enum": [
        "individual",
        "community",
        "city",
        "country",
        "global"
      ],
      "description": "Scale of this example, from individuals to whole countries (per her spec)"
    },
    "submitter_name": {
      "type": "string",
      "description": "Name of the person who submitted this entry"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email of the submitter \u2014 required per Janine's spec for public submissions"
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "description": "Flagged by spam filter for admin attention"
    },
    "ai_assessment": {
      "type": "string",
      "description": "AI pre-screener assessment \u2014 verdict, relevance, reasons"
    }
  },
  "required": [
    "entry_type",
    "title",
    "summary",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}