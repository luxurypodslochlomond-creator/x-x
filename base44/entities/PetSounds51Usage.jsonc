{
  "name": "PetSounds51Usage",
  "type": "object",
  "description": "A line for each time a PetSounds51 protocol was played, tied to whoever played it. Nothing reads or writes it today, so it is admin-only in every direction rather than left open: a table nobody is using is the easiest one to leave a door off by accident.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Who used it (or 'anonymous' for free tier)"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "fireworks",
        "separation",
        "arthritis",
        "travel",
        "surgery",
        "herd"
      ],
      "description": "Which protocol played"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "horse",
        "farm"
      ],
      "description": "Animal type"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "premium",
        "concierge"
      ],
      "description": "Payment tier"
    },
    "session_completed": {
      "type": "boolean",
      "default": false,
      "description": "Did they finish the full session?"
    },
    "duration_seconds": {
      "type": "number",
      "description": "How long they actually listened"
    },
    "effectiveness_rating": {
      "type": "number",
      "description": "1-10 how well it worked (user feedback)"
    },
    "device_fingerprint": {
      "type": "string",
      "description": "Browser fingerprint for fraud detection"
    },
    "free_tier_count": {
      "type": "number",
      "default": 1,
      "description": "How many times this device used free tier"
    }
  },
  "required": [
    "protocol",
    "species",
    "tier"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}