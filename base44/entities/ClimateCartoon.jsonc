{
  "name": "ClimateCartoon",
  "type": "object",
  "description": "A drawing given to the record for the room of cartoons, opened for Janine's workshop on 29 November 2026. Every drawing carries the same three things: who drew it, where it came from, and one line in the drawer's own words on what it is for. A drawing may also answer one entry on the record \u2014 the crisis it is looking at \u2014 and then the crisis and the drawing point at each other. A drawing may also be offered for one of the seventeen goals, from that goal's own panel, and then it is filed against that goal in the sender's own word. A drawing sent in from the open page waits for a keeper: nothing goes on the wall because it was typed into a table with the word 'published' in its hand. The record's machine may add one line about what it can see in a drawing; that line is kept separately from the drawer's words, because a machine's reading is not a person's, and it is labelled as what it is. The sender's own email is kept so the record can reach them about their drawing, and is never shown to a reader.",
  "properties": {
    "title": {
      "type": "string",
      "description": "What the drawing is called, if it has a name. Left empty the wall shows the artist's name alone rather than inventing a title."
    },
    "artist_name": {
      "type": "string",
      "description": "Who drew it. Required, and never the person who happened to send it in: the name on the wall belongs to the hand that made the drawing."
    },
    "origin": {
      "type": "string",
      "description": "Where it came from \u2014 the workshop, the school, the class, the group, the page it was first printed on. Said in the sender's own words."
    },
    "country": {
      "type": "string",
      "description": "The country the drawing was made in, so the drawing stands on the record's map where it was drawn rather than nowhere. Given by the person sending it in, and never inferred from an address, a language or a guess: a drawing with no stated country simply does not appear on the map, and is not counted as though it had."
    },
    "for_line": {
      "type": "string",
      "description": "One line, in the drawer's own words, on what the drawing is for. The record never writes this for them and never corrects it."
    },
    "who_line": {
      "type": "string",
      "description": "Who the hand is, in the words of whoever sent the drawing in \u2014 a sentence or two, quoted, printed under the drawing so a reader is never shown a name and told nothing about it. Kept apart from for_line because this is not the drawer speaking about the drawing: it is the sender's account of the artist, and the wall shows exactly what was given. Empty wherever nobody said who the hand is, which is most drawings, and the wall then says nothing rather than writing a biography the record was not given. Never a profile page: a line, under one picture, for the picture's sake."
    },
    "image_url": {
      "type": "string",
      "description": "The drawing itself, stored publicly so the wall can show it to anyone without a sign-in. Shrunk in the browser before it was stored, so it opens fast on a phone at a workshop."
    },
    "crisis_id": {
      "type": "string",
      "description": "The entry on the record this drawing answers \u2014 a climate crisis, a solution or an action, when a keeper says so. Resolved against the record by its own server, never taken on trust from a browser: an id that is not a published entry leaves the drawing unlinked rather than putting a wrong headline under somebody's work. Empty means the drawing stands on the wall on its own, which most drawings do."
    },
    "crisis_title": {
      "type": "string",
      "description": "That entry's own headline, copied from the entry itself at the moment the drawing was tied to it, so the wall can name it without a lookup and without the sender's words standing in for it."
    },
    "crisis_type": {
      "type": "string",
      "enum": [
        "climate_crisis",
        "solution",
        "action"
      ],
      "enumColors": [
        "red",
        "green",
        "blue"
      ],
      "description": "Which of the record's three doors the tied entry lives behind \u2014 a crisis, a solution or an action \u2014 so the drawing opens the right one. Read off the entry itself by the record's server when the link was made, never chosen by a browser. Empty on a drawing that is not tied to anything, and on the older links made before this was kept, which were all crises."
    },
    "goal": {
      "type": "number",
      "description": "The one of the seventeen goals the person who sent the drawing says it is about \u2014 1 to 17, or empty. Their word, and it is never substituted for the record's own reading: the record's reading of a drawing onto a goal is written by hand elsewhere and printed in red as the record's claim. This number is how a drawing sent in from a goal's own panel comes back to that goal, and how the drawing says on the wall which goal it was offered for. A number outside 1 to 17 is not stored at all rather than being corrected into a goal the sender never named."
    },
    "machine_line": {
      "type": "string",
      "description": "The record's machine reading of the drawing, kept exactly as the machine said it \u2014 whether or not the sender kept it as their line. Kept apart so nobody later mistakes a machine's sentence for the drawer's."
    },
    "credit": {
      "type": "string",
      "description": "Who holds the drawing, where that is not the artist personally \u2014 e.g. '\u00a9 Council on Energy, Environment and Water, 2026'. Shown with the drawing and never separated from it."
    },
    "source_url": {
      "type": "string",
      "description": "A link to where the drawing was first published, when it was published somewhere. The record points at drawings it was not given rather than copying them, and this is the pointing."
    },
    "submitter_email": {
      "type": "string",
      "description": "The email of whoever sent the drawing in, used only to reach them about it. Never shown on the wall and never handed to a reader: only a keeper may read it back.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "A drawing arrives as a draft and waits for a keeper: a picture cannot be sourced by a machine, and the record will not put a drawing on the wall on a machine's word. published means a keeper has seen it and said yes."
    },
    "keeper_note": {
      "type": "string",
      "description": "The keeper's own reason, when a drawing was held back. Kept so the next keeper knows what was decided and why, rather than finding a drawing that simply never appeared."
    }
  },
  "required": [
    "artist_name",
    "image_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}