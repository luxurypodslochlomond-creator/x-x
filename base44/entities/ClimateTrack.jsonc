{
  "name": "ClimateTrack",
  "type": "object",
  "description": "A track given to the climate record by the artist who made it, for anyone to hear without an account. Nothing here is bought, sold, licensed or counted: the artist keeps their name and keeps their rights, the master is stored exactly as it was given, and the record never re-encodes, edits or charges for it. Whether the master is offered to be taken is the giver's own choice, made once when they hand it over and said plainly on the track \u2014 take it whole, or heard here only \u2014 and the record adds no condition of its own to either. A set is the same thing with many works inside it: one continuous piece by a selector, served whole and never cut into chapters, with the works inside it listed in the selector's own order and on their word. The spec, the length and the fingerprint are read from the file itself, so what the record says about a master is the master's own truth \u2014 never a claim someone typed in. And where a keeper takes down a listener's line for something unlawful, a note stays in its place, in the open: the line is never reprinted, and a removal on this record is never quiet. The giver's own email is kept back the same way: it is how the record reaches them about their own work, and never part of what a listener receives.",
  "properties": {
    "title": {
      "type": "string",
      "description": "The track's name. Required."
    },
    "artist_name": {
      "type": "string",
      "description": "Who made it. For a set, the selector who made it. Kept on the track, on its card and on the page it plays from \u2014 never separated from the work. Required."
    },
    "artist_link": {
      "type": "string",
      "description": "One link of the artist's own, if they want one \u2014 their site, their page. The record adds nothing to it and earns nothing from it."
    },
    "kind": {
      "type": "string",
      "enum": [
        "song",
        "instrumental",
        "field_recording",
        "spoken_word",
        "score",
        "set",
        "other"
      ],
      "default": "other",
      "description": "What kind of piece this is, so the music can be found \u2014 a song, an instrumental, a field recording, spoken word, a score, or a set: one continuous work by a selector with many works inside it. Set by the screener when the piece arrives, so the giver is never made to categorise themselves. A giver who says outright that they are giving a set keeps that word, because the arc of a set is theirs to name and no machine hears it."
    },
    "statement": {
      "type": "string",
      "description": "The artist's own words about it, if they gave any. Quoted, never paraphrased. For a set this is where the thing itself is said \u2014 where it was played, how the room took it, what it was for."
    },
    "lyric": {
      "type": "string",
      "description": "The words of the track, as written, if there are any and if the artist gave them. Shown as the artist's own text \u2014 the record does not correct it."
    },
    "tracklist": {
      "type": "string",
      "description": "For a set: the works inside it, in the selector's own order and their own spelling, exactly as they gave the list. Kept as their text and shown as their text. The record does not verify another person's tracklist, does not cut a set into chapters or timings, and never moves a work to a name the selector did not give. Empty for a single track."
    },
    "audio_url": {
      "type": "string",
      "description": "The master itself, stored publicly so anyone may hear it without signing in and without an app. The exact file the artist gave: never re-encoded, never trimmed, never replaced. Required."
    },
    "master_offer": {
      "type": "string",
      "enum": [
        "take_it_whole",
        "listen_here_only"
      ],
      "default": "take_it_whole",
      "description": "The giver's own choice about the master, made once at the door and kept as theirs, then said plainly on the track so nobody has to ask them. take_it_whole \u2014 anyone may take the master, play it out and pass it on, with the artist's name staying on the work: a gift that travels, not a licence. listen_here_only \u2014 it is heard on the record and not offered for keeping. The generous answer is the default, because a room that has to be asked before it gives you the file is not a gift. Neither choice is a lock and neither adds a condition: the master is stored exactly as given either way, and the record never sells, licenses or counts it."
    },
    "spec": {
      "type": "string",
      "description": "The master's real format, read from the file's own header when it arrived \u2014 e.g. 'WAV \u00b7 44.1 kHz \u00b7 16-bit \u00b7 stereo \u00b7 2:42'. Never typed in by anyone, so it cannot overstate a master."
    },
    "seconds": {
      "type": "number",
      "description": "Its length in seconds, read from the same header. Empty when the file's format could not be read. A set is simply a longer one, and the length is read the same way."
    },
    "master_sha256": {
      "type": "string",
      "description": "The fingerprint of the exact bytes the artist gave, taken on their own device before the file was sent \u2014 so the file kept here can be checked against the file handed over, rather than trusted. Never computed from a copy and never re-derived afterwards."
    },
    "cover_url": {
      "type": "string",
      "description": "A picture the artist made for the track, if they gave one, stored publicly. Shown with the track and carried on its card."
    },
    "theme": {
      "type": "boolean",
      "default": false,
      "description": "Set by a keeper on the one piece that stands as the record's own signal \u2014 the theme a reader meets first. It gives that track no rank, no count and no better place in the list: the theme is heard exactly like every other piece, pressed to play and never played at anyone, and the rest of the record is its equal. Only one track carries it; marking another takes it off the last, because a theme is a signal, not a prize."
    },
    "words_note": {
      "type": "string",
      "description": "The keeper's note, in the open, about a line taken down from under this work: that one came off, when, and on what grounds. Written by a keeper and never by anyone else, kept as their own text, newest first. It never reprints the line \u2014 taking something down is not the same as erasing that it happened \u2014 and it exists because a line vanishing without trace would be the one silent edit on a record that corrects everything else in daylight."
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published",
      "description": "A track the screener clears goes up at once, so the artist is never left waiting on a person. Only a flagged track waits, and it waits with a keeper's note beside it."
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "description": "Held back by the screener for a human look. Never set by anything the artist is: the screener reads the words given, not the person who gave them."
    },
    "ai_assessment": {
      "type": "string",
      "description": "The screener's advisory note \u2014 whether this is a track at all, whether the words given are unlawful or abusive, and the kind it read. Advisory only; a person decides what waits."
    },
    "submitter_email": {
      "type": "string",
      "description": "The artist's email \u2014 used only to reach them about their own track, and never published. Never shown to another visitor, never on a card, and never handed to a listener: only a keeper may read it back.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "artist_name",
    "audio_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}