{
  "name": "VisitorsPledge",
  "type": "object",
  "description": "A promise a visitor made to the Earth, written in their own words and signed with their name. Anyone may read the book and anyone may add a page \u2014 that is what a book of pledges is for \u2014 but nobody may rewrite or tear out another person's page: only a keeper may change or remove one.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Visitor's name or anonymous"
    },
    "country": {
      "type": "string",
      "description": "Country of origin"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 2-letter country code"
    },
    "message": {
      "type": "string",
      "description": "Their personal message to Earth"
    },
    "pledge": {
      "type": "string",
      "enum": [
        "I will tread lightly",
        "I will protect what I love",
        "I will leave it better than I found it",
        "I will teach my children",
        "I will speak up for the voiceless"
      ],
      "description": "Their chosen pledge"
    },
    "anonymous": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "message",
    "pledge"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}