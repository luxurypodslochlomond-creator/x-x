{
  "name": "PartnerSuggestion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the suggested organization"
    },
    "website": {
      "type": "string",
      "description": "Website URL"
    },
    "reason": {
      "type": "string",
      "description": "Why user thinks we should partner with them"
    },
    "suggested_by_email": {
      "type": "string",
      "description": "Email of user who suggested"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "under_investigation",
        "approved",
        "rejected"
      ],
      "default": "pending_review"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin notes on this suggestion"
    },
    "community_endorsements": {
      "type": "number",
      "default": 0,
      "description": "Number of community members who also endorse this"
    }
  },
  "required": [
    "name",
    "website",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}