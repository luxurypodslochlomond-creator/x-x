{
  "name": "CB51 Push Notification Sender",
  "description": "Sends browser push notifications when new ScottNotification is created - scales to unlimited devices",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ScottNotification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cb51_push_notification_sender",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendBrowserPush",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendBrowserPush"
  }
}